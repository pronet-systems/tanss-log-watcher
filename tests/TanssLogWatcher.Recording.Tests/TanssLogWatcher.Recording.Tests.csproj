<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Muss dem Ziel des geprüften Projekts folgen: ein Verweis von net10.0-windows auf ein
         versioniertes Ziel ergibt NU1201. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Platforms>x64</Platforms>
    <IsPackable>false</IsPackable>
    <RootNamespace>TanssLogWatcher.Recording.Tests</RootNamespace>
    <!-- Echte Fenster fuer die Fensteraufzaehlung. Ein Test, der sich auf zufaellig geoeffnete
         Anwendungen verliesse, waere kein Test. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\TanssLogWatcher.Recording\TanssLogWatcher.Recording.csproj" />
  </ItemGroup>
</Project>
