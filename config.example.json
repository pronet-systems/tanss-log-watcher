{
  // Vorlage fuer %APPDATA%\ProNet Systems\TanssLogWatcher\config.json.
  //
  // Kommentare und nachgestellte Kommata sind beim LESEN erlaubt (siehe ConfigJson); beim
  // naechsten Schreiben durch den Einrichtungsassistenten sind sie fort. Unbekannte Felder
  // werden dagegen abgelehnt statt uebergangen - eine vertippte Einstellung, die
  // stillschweigend wirkungslos bleibt, ist gefaehrlicher als ein Ladefehler.
  "version": 1,

  "tanss": {
    // Muss auf /backend enden. Zeigt die Adresse auf die Weboberflaeche, antwortet die
    // PHP-Oberflaeche auf jede Anfrage mit HTTP 400 - auch ohne Token.
    "base_url": "https://tanss.kunde.de/backend",

    // Die eigene Mitarbeiter-ID. Sie traegt die gesamte Attribution der Fernwartungen;
    // "tanss-logwatch doctor" prueft sie gegen die Technikerliste der Instanz.
    "employee_id": 42,

    // Verweis auf die Ablage des Tokens, nicht das Token selbst.
    "token_ref": "dpapi:credentials",

    "rotate_before_days": 60,

    // Nur fuer Testinstanzen abschaltbar. doctor meldet false als WARNUNG.
    "verify_tls": true,

    "timeout_seconds": 30
  },

  "watcher": {
    // Der Takt ist zugleich die Messgenauigkeit von Sitzungsbeginn und -ende.
    "poll_interval_seconds": 1,

    // Schonfrist fuer verbindungsbasierte Profile: ohne sie zerfaellt eine Fernwartung mit
    // kurzem Verbindungsabriss in mehrere Datensaetze, und TANSS dedupliziert nicht.
    "ip_session_grace_seconds": 180
  },

  // Die Schluessel stammen aus dem Profilkatalog (MonitoringProfiles); "tanss-logwatch
  // windows --profile <Schluessel>" zeigt, was ein Profil aus den aktuellen Fenstern
  // ableiten wuerde. Die Kennungen sind die der Referenzinstanz - in der eigenen Instanz
  // stehen sie unter "Externe Fernwartungs-Anbindungen verwalten" und muessen mindestens
  // 1000 sein.
  "monitoring": [
    {
      "key": "OUTLOOK|Message",
      "remote_support_type_id": 1001
    },
    {
      "key": "mstsc",
      "remote_support_type_id": 1002,
      // Eigene Server und das eigene Rechenzentrum sind keine Fernwartung.
      "exclude_ip_addresses": ["10.0.0.0/8", "192.168.0.0/16"]
    },
    {
      "key": "putty",
      "remote_support_type_id": 1003
    },
    {
      "key": "WinSCP",
      "remote_support_type_id": 1004
    },
    {
      "key": "AnyDesk",
      "remote_support_type_id": 1005
    },
    {
      "key": "RoyalTS",
      "remote_support_type_id": 1006
    }
  ],

  "proxy": {
    "enabled": false,
    "address": "",
    "port": 8080
  },

  "logging": {
    "level": "info",

    // Voreingestellt AUS. Bei mstsc, RdClient.Windows und putty traegt der Titel einen
    // Rechnernamen und sonst nichts; ein Abdruck statt des Namens kostet dort jede
    // Nachvollziehbarkeit - im Aenderungsprotokoll wie auf der Seite "Verlauf" - und
    // verhindert wenig, weil derselbe Name ohnehin im Kommentar der Fernwartung steht.
    //
    // EINSCHALTEN, sobald ein Profil mehr als einen Rechnernamen in den Titel nimmt: Zehn
    // Profile des Katalogs nehmen den GANZEN Fenstertitel (cmd, powershell, RoyalTS,
    // WindowsTerminal und weitere), die beiden Outlook-Profile den NACHRICHTENBETREFF.
    // Ohne Schwaerzung liegen Betreffzeilen und Dokumentnamen im Klartext in state.db.
    "redact_window_titles": false,

    // Gilt fuer das Aenderungsprotokoll UND fuer die erledigten Warteschlangeneintraege:
    // Letztere tragen die Nutzlast, die nach TANSS ging, und darin die Gegenstelle im
    // Klartext. Wartende und aufgegebene Eintraege sind ausgenommen - sie sind unerledigte
    // Arbeitszeit, gleich wie alt sie werden.
    "retention_days": 30
  },

  // Der Verlauf abgeschlossener Sitzungen - die Seite "Verlauf" und ihre beiden Fristen.
  // Fehlt dieser Abschnitt, gelten genau die Werte, die hier stehen.
  "history": {
    "enabled": true,

    // FRUEHESTENS. Solange zu einer Sitzung noch eine Aufzeichnung auf der Platte liegt,
    // bleibt ihre Verlaufszeile stehen - ein Video, zu dem kein Eintrag mehr sagt, wozu es
    // gehoert, waere schlimmer als der Eintrag. Neunzig Tage, weil eine Fernwartung
    // monatlich abgerechnet und bis zum Ende des Folgemonats beanstandet wird; das naechste
    // volle Quartal darueber ist 90. Ueber recording.retention_days (30) liegt die Zahl
    // ausserdem, damit der Hinweis "Aufzeichnung geloescht" ueberhaupt zu sehen ist.
    "retention_days": 90,

    // null heisst: es gilt logging.redact_window_titles von oben. Die Gegenstelle ist
    // derselbe Text, den jene Einstellung verbirgt - bei zehn der 36 Profile der ganze
    // Fenstertitel, bei den Outlook-Profilen der Nachrichtenbetreff. Eine eigene Vorgabe
    // false schriebe im Klartext auf die Platte, was der Benutzer schwaerzen liess. Wer den
    // Klartext im Verlauf ausdruecklich will, traegt hier false ein; wer umgekehrt nur den
    // Verlauf schwaerzen will, true.
    "redact_destination": null,

    // Wie lange die Gegenstelle im Klartext steht; danach bleibt nur ihr Abdruck. Dieselbe
    // Zahl wie logging.retention_days, damit zwei Fristen fuer denselben Namen nicht
    // auseinanderlaufen. 0 schwaerzt beim naechsten Aufraeumtakt. Greift nur, wo ueberhaupt
    // Klartext festgehalten wird - bei eingeschalteter Schwaerzung gibt es keinen.
    "plain_text_days": 30
  },

  // Bildschirmaufzeichnung der Fernwartungssitzungen. Standardmaessig AUS, und das bleibt sie
  // auch nach dem Einschalten, solange die Kenntnisnahme fehlt: Aufgezeichnet wird der
  // Bildschirm des Kunden (Daten Dritter) und der des Technikers (Leistungs- und
  // Verhaltenskontrolle, Mitbestimmungstatbestand nach BetrVG). Ein Schalter allein waere
  // dafuer die falsche Huerde.
  "recording": {
    "enabled": false,

    // Leer heisst: der vorgesehene Ort im Profil. Ein eigener Ort ist der Normalfall -
    // Videodateien gehoeren selten auf dieselbe Platte wie das Betriebssystem. Der Pfad muss
    // vollstaendig sein; geloescht wird spaeter ausschliesslich unterhalb dieses Ordners.
    "directory": "",

    // Nach wie vielen Tagen geloescht wird. Der tatsaechliche Loeschzeitpunkt jeder einzelnen
    // Aufzeichnung wird beim Abschluss daraus berechnet und festgeschrieben: Wer die Frist
    // spaeter verkuerzt, verkuerzt auch die bestehenden - wer sie verlaengert, verlaengert die
    // bestehenden NICHT. Ein gegebenes Versprechen wird nicht nachtraeglich gedehnt.
    "retention_days": 30,

    // Belegt werden soll, welcher Bildschirmzustand bestand, waehrend der Techniker handelte -
    // nicht, wie sich die Maus bewegte. Bei vier Bildern je Sekunde liegt jeder Zustand ab
    // einer Viertelsekunde in mindestens einem Bild. Fluessige Mausbewegung braeuchte das
    // Vier- bis Achtfache an Daten fuer dieselbe Aussage.
    "frames_per_second": 4,

    // Ein stehender Bildschirm liefert keine Bilder. Ohne diesen Herzschlag haette die Datei
    // dort eine Luecke, und der Abspieler spraenge ueber die Stille hinweg.
    "heartbeat_seconds": 2,

    // Eine volle Platte nimmt auch der Warteschlange den Platz, und die traegt die
    // Arbeitszeit. Die Aufzeichnung tritt vorher zurueck.
    "minimum_free_megabytes": 2048,

    // Die vier Angaben der Kenntnisnahme gehoeren zusammen. Entweder alle oder keine - eine
    // Kenntnisnahme ohne benannte Grundlage ist ein Haken und kein Nachweis. Keine
    // Vorbelegung: Ob bei euch eine Betriebsvereinbarung besteht, weiss dieses Werkzeug nicht.
    "acknowledged_at": null,
    "acknowledged_by": null,
    "legal_basis": null,
    "legal_reference": null
  }
}
