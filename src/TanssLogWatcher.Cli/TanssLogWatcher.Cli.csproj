<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>TanssLogWatcher.Cli</RootNamespace>
    <AssemblyName>tanss-logwatch</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TanssLogWatcher.Api\TanssLogWatcher.Api.csproj" />
    <ProjectReference Include="..\TanssLogWatcher.Monitoring\TanssLogWatcher.Monitoring.csproj" />
    <ProjectReference Include="..\TanssLogWatcher.Storage\TanssLogWatcher.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Die Beispielkonfiguration liegt neben dem Programm. Ein Befehl, der ohne
         Konfiguration anlaeuft, kann dann auf eine Datei verweisen, die wirklich da ist -
         ein Verweis auf eine Vorlage im Quellbaum hilft am Kundenrechner niemandem. -->
    <None Include="..\..\config.example.json" Link="config.example.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TanssLogWatcher.Cli.Tests" />
  </ItemGroup>
</Project>
