<ui:FluentWindow x:Class="TanssLogWatcher.App.Views.SetupWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:design="clr-namespace:TanssLogWatcher.App.Design"
                Title="TANSS Log-Watcher einrichten"
                Width="720" Height="640"
                MinWidth="600" MinHeight="520"
                WindowStartupLocation="CenterScreen"
                WindowBackdropType="Mica"
                ExtendsContentIntoTitleBar="True"
                WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Einrichtung">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Settings24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,8,24,8">
            <StackPanel design:Gap.Size="16">

                <!-- Schritt 1: Anmeldung ............................................... -->
                <StackPanel Visibility="{Binding IsOnLogin, Converter={StaticResource BoolToVis}}"
                            design:Gap.Size="16">

                    <StackPanel>
                        <ui:TextBlock Text="Verbindung zu TANSS" FontTypography="Subtitle" />
                        <ui:TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="Die Anmeldung holt einmalig ein Arbeitstoken. Das Kennwort wird dabei nicht abgelegt — nur das Token, an diesen Windows-Benutzer gebunden." />
                    </StackPanel>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel design:Gap.Size="12">
                            <StackPanel>
                                <ui:TextBlock Text="Basisadresse" FontWeight="SemiBold" />
                                <ui:TextBlock FontSize="11" Margin="0,2,0,4" TextWrapping="Wrap"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Text="Muss auf /backend enden — sonst zeigt sie auf die Weboberfläche statt auf die Schnittstelle." />
                                <ui:TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="https://tanss.kunde.de/backend" />
                            </StackPanel>

                            <StackPanel>
                                <ui:TextBlock Text="Anmeldename" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel>
                                <ui:TextBlock Text="Kennwort" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ui:PasswordBox x:Name="PasswordField" />
                            </StackPanel>

                            <StackPanel>
                                <ui:TextBlock Text="Zweiter Faktor" FontWeight="SemiBold" />
                                <ui:TextBlock FontSize="11" Margin="0,2,0,4" TextWrapping="Wrap"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Text="Leer lassen, wenn die Instanz keinen verlangt." />
                                <ui:TextBox Text="{Binding TwoFactorToken, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <ui:ToggleSwitch Content="Zertifikat der Gegenstelle prüfen"
                                             IsChecked="{Binding VerifyTls}" />
                            <ui:TextBlock FontSize="11" TextWrapping="Wrap"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Text="Abschalten nur bei Testinstanzen mit selbst ausgestelltem Zertifikat. Das Arbeitstoken geht bei jedem Aufruf über diese Leitung, und TANSS kann ein ausgestelltes Token nicht widerrufen." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Schritt 2: Zuordnung .............................................. -->
                <StackPanel Visibility="{Binding IsOnMapping, Converter={StaticResource BoolToVis}}"
                            design:Gap.Size="16">

                    <StackPanel>
                        <ui:TextBlock Text="Welche Anwendung bucht auf welchen Typ?" FontTypography="Subtitle" />
                        <ui:TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="Mindestens eine Zuordnung ist nötig — ohne sie beobachtet das Werkzeug nichts. Nicht zugeordnete Anwendungen werden erkannt, aber nirgends gebucht. Nachträglich änderbar unter „Überwachung“." />
                    </StackPanel>

                    <Border Style="{StaticResource CardBorder}" Padding="0">
                        <ItemsControl ItemsSource="{Binding Mappings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="0,1,0,0" Padding="16,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="240" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <ui:TextBlock Text="{Binding Application}"
                                                              TextTrimming="CharacterEllipsis" />
                                                <ui:TextBlock Text="{Binding Key}" FontSize="11"
                                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                                      ItemsSource="{Binding DataContext.Systems,
                                                                   RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      SelectedItem="{Binding SelectedSystem, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Style="{StaticResource SystemSwatch}"
                                                                    Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- Meldungen ......................................................... -->
                <ui:InfoBar Severity="Error" IsClosable="False"
                            IsOpen="{Binding HasError}"
                            Title="Das hat nicht geklappt"
                            Message="{Binding Error}" />

                <ui:InfoBar Severity="Success" IsClosable="False"
                            IsOpen="{Binding HasSuccess}"
                            Title="Angemeldet"
                            Message="{Binding Success}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Fußzeile mit den Schaltflächen ......................................... -->
        <Border Grid.Row="2"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <!-- Zwei Spalten: Links und rechts lagen im selben Gitterfeld, nur durch
                 HorizontalAlignment getrennt. Wird die Fussleiste schmal, schiebt sich die
                 rechte Gruppe ueber die linke und verdeckt sie - sie steht in der Kinderliste
                 hinten und liegt damit obenauf. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:ProgressRing Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Width="20" Height="20" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            design:Gap.Size="8">
                    <ui:Button Content="Abbrechen" Appearance="Secondary" Click="OnCancel" />

                    <ui:Button Content="Anmelden und prüfen" Appearance="Primary"
                               Icon="{ui:SymbolIcon PlugConnected24}"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                               Visibility="{Binding IsOnLogin, Converter={StaticResource BoolToVis}}"
                               Click="OnLogin" />

                    <ui:Button Content="Zurück" Appearance="Secondary"
                               Visibility="{Binding IsOnMapping, Converter={StaticResource BoolToVis}}"
                               Click="OnBack" />

                    <ui:Button Content="Fertigstellen" Appearance="Primary"
                               Icon="{ui:SymbolIcon Save24}"
                               IsEnabled="{Binding CanFinish}"
                               Visibility="{Binding IsOnMapping, Converter={StaticResource BoolToVis}}"
                               Command="{Binding FinishCommand}" Click="OnFinish" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
