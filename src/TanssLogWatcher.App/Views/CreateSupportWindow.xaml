<ui:FluentWindow x:Class="TanssLogWatcher.App.Views.CreateSupportWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:design="clr-namespace:TanssLogWatcher.App.Design"
                xmlns:views="clr-namespace:TanssLogWatcher.App.Views"
                Title="Leistung aus Timer"
                Width="700" Height="760"
                MinWidth="520" MinHeight="480"
                WindowStartupLocation="CenterScreen"
                WindowBackdropType="Mica"
                ExtendsContentIntoTitleBar="True"
                WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Leistung aus Timer" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="ClipboardTextEdit24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="24,8,24,0">
            <ui:TextBlock Text="{Binding TimerTitle}" FontTypography="Title" TextWrapping="Wrap" />
            <ui:TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4,0,16"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- Text und Ticket der Leistung. Nicht in der Abschnittsliste, weil sie für die
                 ganze Leistung gelten und nicht für einen ihrer Teile. -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <ui:TextBlock Text="LEISTUNG" FontSize="11" Margin="0,0,0,6"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox PlaceholderText="Was insgesamt geleistet wurde"
                                TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"
                                Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Beschriftung fest, Auswahl dehnbar: So bleibt beides in einer Zeile,
                         auch wenn das Fenster schmal gezogen wird. -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MaxWidth="420" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBlock Grid.Column="0" Text="Ticket" VerticalAlignment="Center"
                                      Margin="0,0,8,0" MinWidth="60"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <!-- Text UND SelectedItem sind gebunden, und das ist der Kern der
                             Berichtigung: Das Feld ist bearbeitbar, und wer eine Nummer tippt,
                             die nicht in der Liste steht, lässt SelectedItem auf null stehen.
                             Gebunden war nur SelectedItem - die getippte Nummer fiel lautlos
                             auf 0, und die Leistung wurde ohne Ticket gebucht. Der Text steht
                             auf LostFocus: dann wird aufgelöst und geprüft. -->
                        <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="240"
                                  VerticalAlignment="Center"
                                  IsEditable="True" IsTextSearchEnabled="True"
                                  TextSearch.TextPath="Display" DisplayMemberPath="Display"
                                  ItemsSource="{Binding Tickets}"
                                  SelectedItem="{Binding SelectedTicket, Mode=TwoWay}"
                                  Text="{Binding TicketText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                  ToolTip="Nummer tippen oder aus der Liste wählen. Leer lassen für eine Leistung ohne Ticket." />
                    </Grid>

                    <!-- Das Ergebnis der Prüfung. Zwei Zeilen statt einer mit wechselnder
                         Farbe: Eine Bedingungsformatierung bräuchte einen Stil, und BasedOn auf
                         einen ui:-Typ liess hier schon einmal die Navigation STILL scheitern.
                         Die 68 links sind die Beschriftungsspalte darüber (MinWidth 60 plus 8
                         Abstand): So beginnt der Satz unter dem Feld und nicht unter dem Wort
                         „Ticket“. -->
                    <StackPanel Margin="68,6,0,0">
                        <ui:TextBlock Text="{Binding TicketCheck.Note}" FontSize="12"
                                      TextWrapping="Wrap" HorizontalAlignment="Left"
                                      Visibility="{Binding TicketCheck.ShowNote, Converter={StaticResource BoolToVis}}"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:TextBlock Text="{Binding TicketCheck.Note}" FontSize="12"
                                      TextWrapping="Wrap" HorizontalAlignment="Left"
                                      Visibility="{Binding TicketCheck.ShowWarning, Converter={StaticResource BoolToVis}}"
                                      Foreground="{DynamicResource StateFailedBrush}" />
                    </StackPanel>

                    <!-- Der Ausweg, wenn es die Nummer nicht gibt oder es nie eine gab. Er
                         steht unmittelbar unter dem Ticketfeld, weil er genau dort gebraucht
                         wird: Die Zeile darüber sagt gerade "gibt es nicht". Ohne ihn war das
                         Ticket in TANSS von Hand anzulegen, die Nummer abzuschreiben und dieser
                         Dialog neu zu öffnen. -->
                    <ui:Button Margin="68,10,0,0" Appearance="Secondary"
                               Content="Neues Ticket anlegen"
                               Icon="{ui:SymbolIcon TicketDiagonal24}"
                               IsEnabled="{Binding NewTicket.IsAvailable}"
                               Command="{Binding NewTicket.ToggleCommand}" />

                    <!-- Eigener Rollbereich mit Deckel: Betreff, Beschreibung, Meldung und die
                         Firmenauswahl stehen hier untereinander. Ohne Deckel schöbe der
                         aufgeklappte Bereich die Zeitabschnitte aus dem Fenster - die Zeile
                         darüber ist "Auto", die Abschnitte darunter sind der dehnbare Teil.

                         Die Trefferliste der Firmenauswahl braucht hier keinen Platz mehr: Sie
                         steht in der Aufklappliste des Auswahlfeldes, und die ist ein eigenes
                         Fenster über der Oberfläche - dieser Rollbereich schneidet sie nicht
                         ab. -->
                    <ScrollViewer MaxHeight="300" Margin="0,10,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding NewTicket.IsOpen, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <ui:TextBlock Text="NEUES TICKET" FontSize="11" Margin="0,0,0,6"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                <!-- Die Firmenauswahl als eingesetztes Stück, nicht als
                                     Abschrift: Sie wird auch anderswo gebraucht, und zwei
                                     Abschriften liefen nach der ersten Änderung auseinander.

                                     Sie bringt ihre Beschriftung "Firma" selbst mit und steht
                                     damit in einer Zeile - genauso wie das Ticketfeld darüber,
                                     und mit derselben Spaltenbreite. -->
                                <views:CompanyPicker DataContext="{Binding NewTicket.Company}" />

                                <ui:TextBox Margin="0,10,0,0"
                                            PlaceholderText="Betreff — daran ist das Ticket in jeder Liste zu erkennen"
                                            Text="{Binding NewTicket.Title, UpdateSourceTrigger=PropertyChanged}" />

                                <ui:TextBox Margin="0,8,0,0"
                                            PlaceholderText="Beschreibung (darf leer bleiben)"
                                            TextWrapping="Wrap" AcceptsReturn="True" MinHeight="52"
                                            Text="{Binding NewTicket.Content, UpdateSourceTrigger=PropertyChanged}" />

                                <!-- Zwei Zeilen statt einer mit wechselnder Farbe, aus demselben
                                     Grund wie oben beim Prüfergebnis. -->
                                <ui:TextBlock Text="{Binding NewTicket.Message}" FontSize="12"
                                              TextWrapping="Wrap" Margin="0,8,0,0"
                                              Visibility="{Binding NewTicket.IsWarning, Converter={StaticResource InverseBoolToVis}}"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBlock Text="{Binding NewTicket.Message}" FontSize="12"
                                              TextWrapping="Wrap" Margin="0,8,0,0"
                                              Visibility="{Binding NewTicket.IsWarning, Converter={StaticResource BoolToVis}}"
                                              Foreground="{DynamicResource StateFailedBrush}" />

                                <!-- IsEnabled fällt nach dem ersten angenommenen Aufruf weg und
                                     kommt nicht wieder: Ein zweiter Aufruf legt ein zweites
                                     Ticket an, und es gibt keine Kennung, an der die Dublette
                                     später zu erkennen wäre. -->
                                <ui:Button Margin="0,10,0,0" HorizontalAlignment="Right"
                                           Appearance="Primary" Content="Ticket anlegen"
                                           Icon="{ui:SymbolIcon Add24}"
                                           IsEnabled="{Binding NewTicket.CanCreate}"
                                           Command="{Binding NewTicket.CreateCommand}" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <ui:TextBlock Text="ZEITABSCHNITTE — JEDER EINZELN BESCHRIEBEN" FontSize="11"
                          Margin="0,0,0,6"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Ein Abschnitt je Start-Stopp-Paar des Timers. Die Gliederung kommt von TANSS und
             wird hier nicht erfunden: Was der Techniker als getrennte Arbeitsschritte erfasst
             hat, bleibt getrennt. -->
        <ScrollViewer Grid.Row="2" Margin="24,0,24,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Segments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                            <StackPanel>
                                <!-- Raster statt waagerechter Reihe: Ein StackPanel misst seine
                                     Kinder mit unbegrenzter Breite, TextWrapping lief darin ins
                                     Leere und die lange Form („… gemessen, … abgerechnet“) wurde
                                     rechts abgeschnitten. -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" CornerRadius="4" Padding="6,1"
                                            Margin="0,0,8,0" VerticalAlignment="Center"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <ui:TextBlock Text="{Binding Number}" FontSize="11"
                                                      Style="{StaticResource TabularText}" />
                                    </Border>
                                    <ui:TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="12"
                                                  VerticalAlignment="Center" TextWrapping="Wrap"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <ui:TextBox PlaceholderText="Was in diesem Abschnitt getan wurde"
                                            TextWrapping="Wrap" AcceptsReturn="True" MinHeight="52"
                                            Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Padding="24,16" Margin="0,8,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel>
                <ui:InfoBar Severity="Informational" IsClosable="False" Margin="0,0,0,12"
                            IsOpen="{Binding HasMessage}"
                            Title="Leistung"
                            Message="{Binding Message}" />

                <!-- Rechts und allein: Buchen ist der folgenreiche Weg, und eine gebuchte
                     Leistung ist nur noch in TANSS zu berichtigen. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            design:Gap.Size="8">
                    <ui:Button Content="Abbrechen" Appearance="Secondary"
                               Command="{Binding CancelCommand}" />
                    <ui:Button Content="Leistung buchen" Appearance="Primary"
                               Icon="{ui:SymbolIcon Save24}"
                               IsEnabled="{Binding CanBook}"
                               Command="{Binding BookCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
