<Page x:Class="TanssLogWatcher.App.Views.Pages.QueuePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Warteschlange"
      Style="{StaticResource PageSurface}"
      ScrollViewer.CanContentScroll="False">

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Left">
                <ui:TextBlock Text="Warteschlange" FontTypography="Title" />
                <ui:TextBlock TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left" Margin="0,4,0,0"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="Fertige Sitzungen bleiben hier, bis TANSS sie bestätigt hat. Ein Netzausfall, ein Neustart oder ein Absturz kostet keine Sitzung." />
            </StackPanel>
            <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top"
                       Content="Jetzt senden" Icon="{ui:SymbolIcon Send24}" Appearance="Primary"
                       Command="{Binding FlushCommand}" />
        </Grid>

        <StackPanel Grid.Row="1">
            <ui:TextBlock Text="{Binding CountsText}" Margin="0,0,0,12" FontSize="12"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <ui:InfoBar Margin="0,0,0,16" Severity="Warning" IsClosable="False"
                        IsOpen="{Binding NeedsSetup}"
                        Title="Noch nicht eingerichtet"
                        Message="{Binding Status.Advice}" />

            <!-- Der wichtigste Hinweis dieser Seite: „unbekannt“ heißt nicht „nicht vorhanden“. -->
            <ui:InfoBar Margin="0,0,0,16" Severity="Warning" IsClosable="False"
                        IsOpen="{Binding HasUnknownOutcome}"
                        Title="Eintrag mit unbekanntem Ausgang"
                        Message="Beim Senden brach die Verbindung ab — ob TANSS den Satz schon angenommen hat, ist offen. Vor dem nächsten Versuch wird nachgefragt, statt blind zu wiederholen: TANSS erkennt Dubletten nicht selbst." />

            <ui:InfoBar Margin="0,0,0,16" Severity="Error" IsClosable="False"
                        IsOpen="{Binding HasUnreadableNotice}"
                        Title="Unlesbare Zeilen"
                        Message="{Binding UnreadableNotice}" />

            <ui:InfoBar Margin="0,0,0,16" Severity="Informational" IsClosable="False"
                        IsOpen="{Binding HasLastRun}"
                        Title="Letzter Sendelauf"
                        Message="{Binding LastRun}" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Column="0" Text="SITZUNG" FontSize="11"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Grid.Column="1" Text="ERFASST" FontSize="11"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Grid.Column="2" Text="VERSUCHE" FontSize="11"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Grid.Column="3" Text="ZUSTAND" FontSize="11"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Queue}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,1,0,0" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <ui:TextBlock Text="{Binding Description}" />
                                        <ui:TextBlock Text="{Binding LastError}" FontSize="11" TextWrapping="Wrap"
                                                      HorizontalAlignment="Left" MaxWidth="460"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <ui:TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                  Text="{Binding CreatedText}"
                                                  Style="{StaticResource TabularText}" FontSize="12" />

                                    <ui:TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                  Text="{Binding AttemptsText}"
                                                  Style="{StaticResource TabularText}" FontSize="12" />

                                    <Border Grid.Column="3" Style="{StaticResource StatePill}">
                                        <ui:TextBlock Text="{Binding StateText}" FontSize="11" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</Page>
