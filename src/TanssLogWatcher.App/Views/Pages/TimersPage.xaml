<Page x:Class="TanssLogWatcher.App.Views.Pages.TimersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:design="clr-namespace:TanssLogWatcher.App.Design"
      Title="Timer"
      Style="{StaticResource PageSurface}"
      ScrollViewer.CanContentScroll="False">

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Left" Margin="0,0,16,0">
                <ui:TextBlock Text="Timer" FontTypography="Title" />
                <ui:TextBlock Margin="0,4,0,0" TextWrapping="Wrap" HorizontalAlignment="Left"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="Dieselben Timer wie in TANSS. Ein Timer läuft, solange er eine Startzeit trägt — TANSS kennt nur diesen einen Umschalter." />
            </StackPanel>
            <ui:Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Content="Neu laden" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Secondary"
                       IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                       Command="{Binding LoadCommand}" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <ui:TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,12"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- Anlegen. Startzeit und Dauer setzt TANSS selbst — ein neuer Timer läuft sofort. -->
            <Border Style="{StaticResource CardBorder}">
                <!-- Ein Raster und kein StackPanel: Die beiden Eingabefelder teilen sich,
                     was da ist, und die Schaltfläche behält ihre Spalte. Vorher standen hier
                     feste Breiten - bei schmalem Fenster wurde „Timer anlegen“ erst halb
                     abgeschnitten, dann ganz verdrängt, und ein Timer war nicht mehr anzulegen.
                     Umbrechen wäre die falsche Abhilfe gewesen: Ein Knopf, der die Zeile
                     wechselt, ist beim nächsten Blick woanders. Statt dessen schrumpfen die
                     Felder - bis zu ihrer MinWidth, und darunter kommt das Fenster gar nicht
                     erst (MainWindow.MinWidth). -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" MaxWidth="300" />
                        <ColumnDefinition Width="*" MinWidth="220" MaxWidth="360" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"
                                PlaceholderText="Titel des neuen Timers"
                                Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" />
                    <!-- Auswahl statt Zahlenfeld: Hier stand eine freie Eingabe, die jede
                         Zahl annahm - auch eine, zu der es kein Ticket gibt. Die Liste kommt
                         vom Server und enthält nur OFFENE Tickets des Technikers. -->
                    <ComboBox Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center"
                              IsEditable="True" IsTextSearchEnabled="True"
                              TextSearch.TextPath="Display"
                              DisplayMemberPath="Display"
                              ItemsSource="{Binding Tickets}"
                              SelectedItem="{Binding SelectedTicket, Mode=TwoWay}"
                              ToolTip="Tippen sucht in Nummer und Titel. Leer lassen für einen Timer ohne Ticket." />
                    <ui:Button Grid.Column="2" Content="Timer anlegen" Icon="{ui:SymbolIcon Add24}"
                               Appearance="Primary" VerticalAlignment="Center"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                               Command="{Binding CreateCommand}" />
                </Grid>
            </Border>

            <ui:TextBlock Text="{Binding TicketHint}" FontSize="11" Margin="0,6,0,0"
                          TextWrapping="Wrap" HorizontalAlignment="Left"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Die Rollfläche gehört hierher und nicht an das ItemsControl: Dessen Vorlage enthält
             keine, die angehängte Eigenschaft lief deshalb ins Leere. Bei mehr Timern, als auf
             die Seite passen, waren die unteren schlicht nicht erreichbar - kein Bildlauf, kein
             Hinweis, sie waren einfach weg. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Timers}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- TANSS kennt nur einen Umschalter; die Beschriftung folgt dem
                                 zuletzt gelesenen Stand, danach wird neu gelesen. -->
                            <ui:Button Grid.Column="0" Margin="0,0,16,0" Width="44" Height="44"
                                       Appearance="Secondary"
                                       ToolTip="{Binding ToggleText}"
                                       Command="{Binding DataContext.ToggleCommand,
                                                 RelativeSource={RelativeSource AncestorType=Page}}"
                                       CommandParameter="{Binding}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Icon">
                                            <Setter.Value>
                                                <ui:SymbolIcon Symbol="Play24" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Icon">
                                                    <Setter.Value>
                                                        <ui:SymbolIcon Symbol="Pause24" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ui:TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" design:Gap.Size="10" Margin="0,2,0,0">
                                    <ui:TextBlock Text="{Binding TicketText}" FontSize="12"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:TextBlock Text="{Binding StateText}" FontSize="12"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <ui:TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="16,0"
                                          Text="{Binding ElapsedText}" FontSize="22"
                                          Style="{StaticResource TabularText}" />

                            <!-- Buchen steht vor Löschen und trägt Text: Es ist der Weg, den
                                 ein Timer normalerweise nimmt. Löschen bleibt ein Symbol - die
                                 erfasste Zeit ist danach weg. -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                        design:Gap.Size="4">
                                <ui:Button Content="Leistung" Icon="{ui:SymbolIcon ClipboardTextEdit24}"
                                           Appearance="Secondary"
                                           ToolTip="Aus diesem Timer eine Leistung in TANSS machen — mit einer Beschreibung je Zeitabschnitt"
                                           Command="{Binding DataContext.BookCommand,
                                                     RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent"
                                           ToolTip="Timer in TANSS löschen — erfasste Zeit ist danach weg"
                                           Command="{Binding DataContext.DeleteCommand,
                                                     RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
