<!--
    Die Fensterbreite ist die Stelle, an der über sichtbare Bedienelemente entschieden wird.

    MinWidth=1100 ist nicht gegriffen, sondern gemessen: Die breiteste Seite ist „Überwachung“.
    Ihre Tabelle braucht 140 + 220 + 240 DIP für Erkennung, Fernwartungstyp und Ausschlussliste,
    dazu mindestens 200 für den Anwendungsnamen und 2×16 Kartenrand — zusammen 814. Mit dem
    Seitenrand (2×24) sind es 862, mit dem ausgeklappten Navigationsbereich (OpenPaneLength=220)
    1082. 1100 lässt den Rest für den Fensterrahmen und die senkrechte Rollfläche.

    Das ist die Alternative zum Umbrechen: Statt eine Schaltfläche in die nächste Zeile rutschen
    zu lassen — wo sie beim nächsten Blick nicht mehr steht, wo sie vorher war —, lässt sich das
    Fenster gar nicht erst so klein ziehen, dass sie nicht mehr hinpasst.

    Width=1200 ist die Voreinstellung beim ersten Start: etwas mehr als das Minimum, damit die
    Spalten nicht auf Kante stehen.
-->
<ui:FluentWindow x:Class="TanssLogWatcher.App.Views.MainWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:design="clr-namespace:TanssLogWatcher.App.Design"
                xmlns:pages="clr-namespace:TanssLogWatcher.App.Views.Pages"
                xmlns:tb="http://www.hardcodet.net/taskbar"
                Title="TANSS Log-Watcher"
                Width="1200" Height="760"
                MinWidth="1100" MinHeight="560"
                WindowStartupLocation="CenterScreen"
                WindowBackdropType="Mica"
                ExtendsContentIntoTitleBar="True"
                WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="TANSS Log-Watcher">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="DesktopPulse24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView Grid.Row="1"
                           x:Name="Navigation"
                           PaneDisplayMode="Left"
                           OpenPaneLength="220"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True">

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Sitzungen" TargetPageType="{x:Type pages:SessionsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Play24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Warteschlange" TargetPageType="{x:Type pages:QueuePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="ArrowUpload24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Timer" TargetPageType="{x:Type pages:TimersPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Timer24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!-- Oben und nicht im Fußbereich: Der Verlauf beantwortet eine Frage des
                     Arbeitsalltags („war das abgerechnet, wo ist das Video von neulich“) und
                     nicht eine der Einrichtung. Er steht unter „Timer“, weil er die drei
                     darüber der Reihe nach fortsetzt: was läuft, was hinausgeht, was gebucht
                     ist - und schliesslich, was davon geblieben ist. -->
                <ui:NavigationViewItem Content="Verlauf" TargetPageType="{x:Type pages:HistoryPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="History24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Überwachung" TargetPageType="{x:Type pages:MonitoringPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Eye24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Aufzeichnung" TargetPageType="{x:Type pages:RecordingPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Record24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Diagnose" TargetPageType="{x:Type pages:DiagnosticsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Stethoscope24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Einstellungen" TargetPageType="{x:Type pages:ConnectionPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="PlugConnected24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!-- Eine Seite wie jede andere, obwohl sie als Fenster begann. Der Grund
                     dagegen trug nicht: Die Navigation arbeitet auch ohne Konfiguration, jede
                     Seite sagt das auf ihre Art, und diese hier braucht die Laufzeit ohnehin
                     nicht - sie liest das Erzeugnis selbst. -->
                <ui:NavigationViewItem Content="Über" TargetPageType="{x:Type pages:AboutPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Info24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- Fußzeile: der Zustand, den man im Blick behalten will, ohne eine Seite zu öffnen. -->
        <!-- DIE AUSKUNFT ZUR ZUSTANDSPLAKETTE.

             Sie sass zuerst in einem Popup. Gemessen ist es nie erschienen - der Befehl lief,
             die Schaltflaeche antwortete, das Popup blieb unsichtbar. Statt daran
             weiterzuraten steht die Auskunft jetzt im gewoehnlichen Layout: dieselbe
             Gitterzeile wie die Fusszeile, darueber ausgerichtet. Das hat keine Eigenheiten,
             es laesst sich abmessen, und es ueberdeckt nichts, was der Techniker gerade liest.

             VerticalAlignment="Bottom" in Zeile 2: Die Fusszeile ist "Auto" hoch, die Auskunft
             legt sich darueber und waechst nach OBEN in den Inhaltsbereich hinein. -->
        <Border Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Bottom"
                HorizontalAlignment="Left" Margin="12,0,12,40"
                MaxWidth="620" Padding="16,12" CornerRadius="8"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Visibility="{Binding IsWarningsOpen, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBlock Grid.Column="0" Text="Zustand"
                                  FontTypography="BodyStrong" VerticalAlignment="Center" />

                    <!-- Ein eigener Schliesser: Die Auskunft liegt ueber dem Inhalt, und wer
                         sie loswerden will, soll nicht raten muessen, wohin er klickt. -->
                    <ui:Button Grid.Column="1" Appearance="Transparent" Padding="6,2"
                               Icon="{ui:SymbolIcon Dismiss24}"
                               ToolTip="Schliessen"
                               Command="{Binding ToggleWarningsCommand}" />
                </Grid>

                <!-- Ohne Warnung: der eine Satz, damit der Klick nie ins Leere geht. -->
                <ui:TextBlock Text="{Binding NoWarningText}"
                              FontSize="12" TextWrapping="Wrap"
                              Visibility="{Binding HasWarnings, Converter={StaticResource InverseBoolToVis}}"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <!-- Mit Warnung: je Eintrag Titel, Grund und Vorschlag. Der Vorschlag ist der
                     einzige Teil, mit dem jemand etwas anfangen kann - er faellt nicht weg. -->
                <ItemsControl ItemsSource="{Binding Warnings}"
                              Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ui:SymbolIcon Symbol="Warning24" FontSize="16"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ui:TextBlock Text="{Binding Title}"
                                                  FontTypography="BodyStrong"
                                                  TextWrapping="Wrap"
                                                  VerticalAlignment="Center" />
                                </StackPanel>
                                <ui:TextBlock Text="{Binding Reason}" FontSize="12"
                                              TextWrapping="Wrap" Margin="24,0,0,4"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBlock Text="{Binding Advice}" FontSize="12"
                                              TextWrapping="Wrap" Margin="24,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <!-- Zwei Spalten, nicht ein Feld für beides. Vorher lagen die linke und die rechte
                 Gruppe im selben Gitterfeld, nur durch HorizontalAlignment auseinandergehalten -
                 und die rechte liegt in der Kinderliste hinten, deckt die linke also zu, sobald
                 es eng wird. Eng wird es nicht nur beim Verschmälern: Sobald der erste Eintrag
                 in der Warteschlange liegt, wächst die rechte Gruppe zur Laufzeit um rund
                 124 DIP, ohne dass jemand am Fenster gezogen hätte. Und die Basisadresse links
                 ist so lang, wie die Instanz des Kunden heisst. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left"
                            Margin="0,0,16,0" design:Gap.Size="16">
                    <StackPanel Orientation="Horizontal" design:Gap.Size="6">
                        <!-- Die Farbe der Plakette folgt dem Zustand. Über Auslöser und nicht
                             über eine Eigenschaft im Ansichtsmodell: Ein Pinsel dort wäre beim
                             Wechsel zwischen heller und dunkler Darstellung eingefroren. -->
                        <!-- Die Plakette ist anklickbar: Sie sagte "verbunden, mit Warnung",
                             und es gab nirgends einen Ort, an dem stand, WELCHE. Ein Hinweis,
                             den niemand nachlesen kann, beunruhigt nur.

                             Ein Ereignis im Quelltext dahinter und kein Befehl: Die Auskunft
                             braucht das Element selbst als Bezugspunkt (PlacementTarget), und
                             der Klick tut nichts als aufklappen - er greift in keinen Zustand
                             ein, der eine Pruefung verdiente. Denselben Griff benutzt schon das
                             Symbol im Infobereich. -->
                        <!-- EINE SCHALTFLAECHE und kein Border mit Mausereignis. Der Border
                             hatte MouseLeftButtonUp; gemessen ist der Behandler nie gelaufen -
                             der Klick trifft die Beschriftung darin, und dieses Ereignis ist
                             kein zuverlaessiger Weg nach oben.

                             Eine Schaltflaeche loest das dreifach: Sie fuehrt einen Befehl
                             statt eines Ereignisses, sie ist mit der Tastatur erreichbar, und
                             sie traegt das Invoke-Muster - damit laesst sich der Klick
                             nachmessen, statt ihn zu glauben.

                             Die Vorlage ist auf den reinen Inhalt heruntergenommen: Die Farbe
                             der Plakette steckt im Border darin, und der Standardrahmen einer
                             Schaltflaeche legte sich sonst darum. Kein BasedOn auf einen
                             ui:-Typ - das liess in diesem Haus schon einmal die Navigation
                             STILL scheitern. -->
                        <!-- KEIN eigener Margin: design:Gap.Size setzt den Abstand zum
                             Nachbarn nur dann, wenn das Kind keinen eigenen hat. Hier stand
                             Margin="0" - damit klebte die Plakette an der Adresse daneben. -->
                        <Button Command="{Binding ToggleWarningsCommand}"
                                Cursor="Hand" Padding="0"
                                BorderThickness="0" Background="Transparent"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="Zustandsplakette"
                                ToolTip="Anklicken: zeigt, was gerade zu beachten ist.">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Button.Template>
                        <Border x:Name="StatePill" Padding="6,1" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StatePillOnColor}">
                                    <Setter Property="Background" Value="{DynamicResource StateIdleBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status.State}" Value="Working">
                                            <Setter Property="Background" Value="{DynamicResource StateRunningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status.State}" Value="Degraded">
                                            <Setter Property="Background" Value="{DynamicResource StateFailedBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status.State}" Value="NotConfigured">
                                            <Setter Property="Background" Value="{DynamicResource StatePendingBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:TextBlock Text="{Binding StateText}" FontSize="11" />
                        </Border>
                        </Button>

                        <!-- Die einzige Angabe hier, deren Länge der Kunde bestimmt. Sie darf
                             kürzen, statt den Rest der Zeile hinauszuschieben; vollständig
                             steht sie im Hinweisfenster und unter „Einstellungen“. -->
                        <ui:TextBlock Text="{Binding BaseUrlText}"
                                      FontSize="12" VerticalAlignment="Center"
                                      TextTrimming="CharacterEllipsis"
                                      ToolTip="{Binding BaseUrlText}"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ui:TextBlock Text="{Binding EmployeeText}" FontSize="12" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            design:Gap.Size="16">
                    <!-- DIE NEUE FASSUNG.

                         Geprueft wurde schon immer - eine Minute nach dem Start und danach
                         taeglich. Gesagt wurde es nur auf der Seite "Verbindung", und die
                         oeffnet im Betrieb niemand: Das Werkzeug laeuft mit geschlossenem
                         Fenster. Eine Aktualisierung, von der man nur erfaehrt, wenn man
                         ohnehin nachsieht, ist keine Benachrichtigung.

                         Anklickbar und nicht bloss ein Hinweis: Der Klick fuehrt dorthin, wo
                         sich die Version auch holen laesst. Ein Hinweis ohne Weg dahin
                         zwaenge den Techniker, danach zu suchen.

                         Sichtbar nur, wenn es wirklich etwas gibt - sonst waere es eine
                         Dauerzeile, die man nach drei Tagen nicht mehr liest. -->
                    <ui:Button Appearance="Transparent" Padding="8,2"
                               VerticalAlignment="Center"
                               Icon="{ui:SymbolIcon ArrowDownload24}"
                               Content="{Binding UpdateText}"
                               FontSize="12"
                               AutomationProperties.AutomationId="Aktualisierungshinweis"
                               ToolTip="Eine neuere Version steht bereit. Anklicken öffnet „Verbindung“ — dort lässt sie sich holen und einspielen."
                               Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"
                               Click="OnUpdateHintClick" />

                    <ui:TextBlock Text="{Binding QueueText}" FontSize="12" VerticalAlignment="Center"
                                  Visibility="{Binding HasQueue, Converter={StaticResource BoolToVis}}"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Text="{Binding SessionsText}" FontSize="12" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Text="{Binding TokenText}" FontSize="12" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Das Symbol im Infobereich. Es ist immer sichtbar - siehe App.xaml.cs. -->
        <tb:TaskbarIcon x:Name="Tray"
                        Grid.Row="0"
                        IconSource="pack://application:,,,/Assets/tray.ico"
                        ToolTipText="{Binding TrayToolTip}"
                        NoLeftClickDelay="True"
                        TrayLeftMouseUp="OnTrayOpen">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Fenster öffnen" Click="OnTrayOpen" />
                    <Separator />
                    <MenuItem Header="Überwachung angehalten" IsCheckable="True" x:Name="TrayPause"
                              IsChecked="{Binding IsPaused, Mode=TwoWay}" />
                    <Separator />
                    <MenuItem Header="Beenden" Click="OnTrayExit" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</ui:FluentWindow>
