<!--
    Die Fensterbreite ist die Stelle, an der über sichtbare Bedienelemente entschieden wird.

    MinWidth=1100 ist nicht gegriffen, sondern gemessen: Die breiteste Seite ist „Überwachung“.
    Ihre Tabelle braucht 140 + 220 + 240 DIP für Erkennung, Fernwartungstyp und Ausschlussliste,
    dazu mindestens 200 für den Anwendungsnamen und 2×16 Kartenrand — zusammen 814. Mit dem
    Seitenrand (2×24) sind es 862, mit dem ausgeklappten Navigationsbereich (OpenPaneLength=220)
    1082. 1100 lässt den Rest für den Fensterrahmen und die senkrechte Rollfläche.

    Das ist die Alternative zum Umbrechen: Statt eine Schaltfläche in die nächste Zeile rutschen
    zu lassen — wo sie beim nächsten Blick nicht mehr steht, wo sie vorher war —, lässt sich das
    Fenster gar nicht erst so klein ziehen, dass sie nicht mehr hinpasst.

    Width=1200 ist die Voreinstellung beim ersten Start: etwas mehr als das Minimum, damit die
    Spalten nicht auf Kante stehen.
-->
<ui:FluentWindow x:Class="TanssLogWatcher.App.Views.MainWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:design="clr-namespace:TanssLogWatcher.App.Design"
                xmlns:pages="clr-namespace:TanssLogWatcher.App.Views.Pages"
                xmlns:tb="http://www.hardcodet.net/taskbar"
                Title="TANSS Log-Watcher"
                Width="1200" Height="760"
                MinWidth="1100" MinHeight="560"
                WindowStartupLocation="CenterScreen"
                WindowBackdropType="Mica"
                ExtendsContentIntoTitleBar="True"
                WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="TANSS Log-Watcher">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="DesktopPulse24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView Grid.Row="1"
                           x:Name="Navigation"
                           PaneDisplayMode="Left"
                           OpenPaneLength="220"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True">

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Sitzungen" TargetPageType="{x:Type pages:SessionsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Play24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Warteschlange" TargetPageType="{x:Type pages:QueuePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="ArrowUpload24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Timer" TargetPageType="{x:Type pages:TimersPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Timer24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Überwachung" TargetPageType="{x:Type pages:MonitoringPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Eye24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Diagnose" TargetPageType="{x:Type pages:DiagnosticsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Stethoscope24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Verbindung" TargetPageType="{x:Type pages:ConnectionPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="PlugConnected24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- Fußzeile: der Zustand, den man im Blick behalten will, ohne eine Seite zu öffnen. -->
        <Border Grid.Row="2"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <!-- Zwei Spalten, nicht ein Feld für beides. Vorher lagen die linke und die rechte
                 Gruppe im selben Gitterfeld, nur durch HorizontalAlignment auseinandergehalten -
                 und die rechte liegt in der Kinderliste hinten, deckt die linke also zu, sobald
                 es eng wird. Eng wird es nicht nur beim Verschmälern: Sobald der erste Eintrag
                 in der Warteschlange liegt, wächst die rechte Gruppe zur Laufzeit um rund
                 124 DIP, ohne dass jemand am Fenster gezogen hätte. Und die Basisadresse links
                 ist so lang, wie die Instanz des Kunden heisst. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left"
                            Margin="0,0,16,0" design:Gap.Size="16">
                    <StackPanel Orientation="Horizontal" design:Gap.Size="6">
                        <!-- Die Farbe der Plakette folgt dem Zustand. Über Auslöser und nicht
                             über eine Eigenschaft im Ansichtsmodell: Ein Pinsel dort wäre beim
                             Wechsel zwischen heller und dunkler Darstellung eingefroren. -->
                        <Border Padding="6,1" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StatePillOnColor}">
                                    <Setter Property="Background" Value="{DynamicResource StateIdleBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status.State}" Value="Working">
                                            <Setter Property="Background" Value="{DynamicResource StateRunningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status.State}" Value="Degraded">
                                            <Setter Property="Background" Value="{DynamicResource StateFailedBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status.State}" Value="NotConfigured">
                                            <Setter Property="Background" Value="{DynamicResource StatePendingBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:TextBlock Text="{Binding StateText}" FontSize="11" />
                        </Border>
                        <!-- Die einzige Angabe hier, deren Länge der Kunde bestimmt. Sie darf
                             kürzen, statt den Rest der Zeile hinauszuschieben; vollständig
                             steht sie im Hinweisfenster und unter „Verbindung“. -->
                        <ui:TextBlock Text="{Binding BaseUrlText}"
                                      FontSize="12" VerticalAlignment="Center"
                                      TextTrimming="CharacterEllipsis"
                                      ToolTip="{Binding BaseUrlText}"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ui:TextBlock Text="{Binding EmployeeText}" FontSize="12" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            design:Gap.Size="16">
                    <ui:TextBlock Text="{Binding QueueText}" FontSize="12" VerticalAlignment="Center"
                                  Visibility="{Binding HasQueue, Converter={StaticResource BoolToVis}}"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Text="{Binding SessionsText}" FontSize="12" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Text="{Binding TokenText}" FontSize="12" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Das Symbol im Infobereich. Es ist immer sichtbar - siehe App.xaml.cs. -->
        <tb:TaskbarIcon x:Name="Tray"
                        Grid.Row="0"
                        IconSource="pack://application:,,,/Assets/tray.ico"
                        ToolTipText="{Binding TrayToolTip}"
                        NoLeftClickDelay="True"
                        TrayLeftMouseUp="OnTrayOpen">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Fenster öffnen" Click="OnTrayOpen" />
                    <Separator />
                    <MenuItem Header="Überwachung angehalten" IsCheckable="True" x:Name="TrayPause"
                              IsChecked="{Binding IsPaused, Mode=TwoWay}" />
                    <Separator />
                    <MenuItem Header="Beenden" Click="OnTrayExit" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</ui:FluentWindow>
