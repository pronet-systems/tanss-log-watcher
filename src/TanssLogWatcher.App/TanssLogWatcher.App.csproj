<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      Versioniertes Windows-Ziel, erzwungen von TanssLogWatcher.Recording: Ein Verweis von
      net10.0-windows (das ist Plattformstand 7.0) auf ein versioniertes Ziel ergibt NU1201,
      einen harten Fehler - nachgemessen, nicht vermutet. Die Zusage der README auf Windows 10
      haelt SupportedOSPlatformVersion.
    -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>TanssLogWatcher.App</RootNamespace>
    <AssemblyName>TanssLogWatcher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <!-- Deutsche Oberflaeche: die invariante Globalisierung wuerde Datums- und
         Zahlenformate auf en-US zwingen. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.47.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets/tray.ico" />
    <Resource Include="Assets/pronet-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Die Aufzeichnung einer einzelnen Sitzung ist intern: Sie gehoert dem Dienst und
         niemandem sonst. Gepruft werden muss sie trotzdem - und zwar gegen ein echtes
         Fenster, eine echte Datei und eine echte Buchfuehrung. -->
    <InternalsVisibleTo Include="TanssLogWatcher.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Zweimal mit Absicht: eingebettet, damit der Zustand "Nicht eingerichtet" die Vorlage
         auch dann noch anbieten kann, wenn neben der Anwendung nichts mehr liegt - und als
         Datei daneben, damit man sie ohne Start ansehen kann. Siehe Runtime/ConfigTemplate.cs. -->
    <EmbeddedResource Include="config.example.json" LogicalName="TanssLogWatcher.App.config.example.json" />
    <None Include="config.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TanssLogWatcher.Api\TanssLogWatcher.Api.csproj" />
    <ProjectReference Include="..\TanssLogWatcher.Monitoring\TanssLogWatcher.Monitoring.csproj" />
    <ProjectReference Include="..\TanssLogWatcher.Recording\TanssLogWatcher.Recording.csproj" />
    <ProjectReference Include="..\TanssLogWatcher.Storage\TanssLogWatcher.Storage.csproj" />
  </ItemGroup>
</Project>
